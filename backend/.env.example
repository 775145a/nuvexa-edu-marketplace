# ===== Nuvexa Backend Environment Example =====
# Copy to .env and fill real values. NEVER commit .env with secrets.

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
PLATFORM_URL=http://localhost:3000
PLATFORM_NAME=Nuvexa
DEFAULT_COMMISSION_RATE=15

# Percent of the order total credited to the referrer's wallet when a student
# checks out with the referrer's code.
REFERRAL_REWARD_PERCENT=10

# Set TRUST_PROXY=true only when running behind Nginx/load balancer
TRUST_PROXY=false

# PostgreSQL (production): postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# Strong random secrets are REQUIRED in production
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# SMTP (OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Nuvexa

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Rate limiting (requests per window per IP)
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=15
RATE_LIMIT_OTP=10
RATE_LIMIT_UPLOAD=60

# Uploads
UPLOAD_MAX_FILE_SIZE=2147483648
UPLOAD_PATH=./uploads
STORAGE_PROVIDER=local
SIGNED_URL_TTL=3600

# Image optimization (sharp). Set OPTIMIZE_IMAGES=false to disable.
OPTIMIZE_IMAGES=true
IMAGE_MAX_WIDTH=1600
IMAGE_QUALITY=80

# Cache: memory (default) | redis
CACHE_PROVIDER=memory
CACHE_TTL=60
REDIS_URL=redis://localhost:6379

# Job queue for email: direct (default, awaited) | redis (BullMQ workers)
QUEUE_PROVIDER=direct

# Video transcoding to HLS (requires ffmpeg). Enable with TRANSCODE_VIDEOS=true.
# Upload lecture videos with ?transcode=true to get an HLS playlist.
TRANSCODE_VIDEOS=false
FFMPEG_PATH=ffmpeg
HLS_SEGMENT_SECONDS=6
HLS_MAX_HEIGHT=720
HLS_SEGMENT_TTL=604800

# Optional S3 (future scale-out). Leave empty for local storage.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Backups
# Shared secret that authorizes the automated DB backup cron (Vercel Cron sends it
# as "Authorization: Bearer <CRON_SECRET>"). Set the same value in Vercel as CRON_SECRET.
CRON_SECRET=

# Payments
# PAYMENT_PROVIDER: mock (default, no credentials needed) | paymob
# NOTE: Vodafone provides NO public direct merchant API. Real automated Vodafone Cash
# collection goes through an aggregator (Paymob Mobile Wallet / Fawry). Set provider to
# paymob + real credentials below to process REAL charges with OTP. Until then the flow
# runs in manual/mock mode (student transfers to the store wallet and enters the reference).
PAYMENT_PROVIDER=mock

# Value Added Tax rate (%) applied on top of the course price (Egypt VAT = 14)
VAT_RATE=14

# Merchant wallet shown to students when paying via Vodafone Cash (manual/mock mode)
STORE_WALLET=01000000000

# Direct Vodafone Cash merchant integration (Vodafone Egypt Open API).
# Leave empty to run the Vodafone Cash provider in mock mode.
# Set VODAFONE_CASH_ENABLED=true + client credentials for the real API.
VODAFONE_CASH_ENABLED=false
VODAFONE_CASH_BASE_URL=https://openapi.vodafone.com.eg
VODAFONE_CASH_CLIENT_ID=
VODAFONE_CASH_CLIENT_SECRET=
VODAFONE_CASH_MERCHANT_ID=
VODAFONE_CASH_SECRET_KEY=
VODAFONE_CASH_KEY_ID=
VODAFONE_CASH_PUBLIC_KEY=

# Paymob — Vodafone Cash ONLY (Mobile Wallet charge, OTP confirmed in the Vodafone Cash app).
# PAYMENT_PROVIDER=paymob requires PAYMOB_API_KEY + PAYMOB_WALLET_INTEGRATION_ID (from
# Paymob dashboard > Developers > Integrations > Mobile Wallet / Vodafone Cash).
# PAYMOB_INTEGRATION_ID (cards) and PAYMOB_IFRAME_ID are no longer used.
PAYMOB_API_KEY=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP
